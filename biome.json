{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/*.md", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "hono",
                      "hono/**",
                      "@hono/**",
                      "react",
                      "react/**",
                      "react-dom",
                      "react-dom/**",
                      "vite",
                      "vite/**",
                      "@tanstack/**"
                    ],
                    "message": "packages/core is the framework-free engine and must not import web or server frameworks. Put framework code in apps/server or apps/web, and pass plain data into core."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
