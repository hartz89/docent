{
  "name": "docent",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "tsc -b && biome check && node scripts/check-agents-md.ts && vitest run",
    "test:e2e": "pnpm build && playwright test",
    "dev": "pnpm --filter @docent/web dev",
    "docent": "pnpm -s build && node apps/server/dist/cli.js",
    "fix": "biome check --write",
    "check:context": "node scripts/check-context-loading.ts",
    "build": "tsc -b && pnpm --filter @docent/web build",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "fast-check": "4.10.2",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
