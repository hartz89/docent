{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm verify:*)",
      "Bash(pnpm test:e2e:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm fix:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm exec biome:*)",
      "Bash(pnpm exec vitest:*)",
      "Bash(pnpm exec playwright:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git fetch:*)",
      "Bash(git push -u origin:*)",
      "Bash(git push origin:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(node scripts/as-agent.ts:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * +*)",
      "Bash(git push origin main*)",
      "Bash(git push -u origin main*)",
      "Bash(git push origin *:main*)",
      "Bash(git push -u origin *:main*)",
      "Bash(node scripts/as-agent.ts * --force*)",
      "Bash(node scripts/as-agent.ts * -f *)",
      "Bash(node scripts/as-agent.ts * +*)",
      "Bash(node scripts/as-agent.ts * --admin*)"
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm install --frozen-lockfile --prefer-offline",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/sync-main-checkout.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
